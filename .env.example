# Fake example values only. Never commit a real client secret or token.
# Register the exact redirect URL in your traQ OAuth client and allow
# the read and write scopes requested by traq-tui.
TRAQ_API_BASE_URL=https://q.example.test/api/v3
TRAQ_CLIENT_ID=replace-with-client-id
TRAQ_CLIENT_SECRET=replace-with-client-secret
TRAQ_REDIRECT_URL=http://127.0.0.1:18080/oauth/callback

# Optional. A relative token path is resolved from the working directory.
# Its existing parent directory must have mode 0700.
# TRAQ_TUI_TOKEN_FILE=.traq-tui/token.json
# TRAQ_TUI_POLL_INTERVAL=5s
