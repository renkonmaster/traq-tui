# Register this exact callback URL in your traQ OAuth client.
TRAQ_API_BASE_URL=https://q.example.test/api/v3
TRAQ_CLIENT_ID=replace-with-client-id
TRAQ_CLIENT_SECRET=replace-with-client-secret
TRAQ_REDIRECT_URL=http://127.0.0.1:18080/callback

# Optional:
# TRAQ_TUI_TOKEN_FILE=.traq-tui/token.json
# TRAQ_TUI_POLL_INTERVAL=5s
